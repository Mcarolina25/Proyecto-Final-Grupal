# ==========================
# MÓDULO: Microservicio Compilar JSON (event–driven, GCS metadata + archivado)
# ==========================

# --------------------------
# 1) Librerías necesarias
# --------------------------
import logging
import json
from flask import Request, make_response
from google.cloud import storage

# --------------------------
# 2) Configuración de logging
# --------------------------
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# --------------------------
# 3) Parámetros globales
# --------------------------
# Carpeta raíz donde están los crudos y el compilado:
BASE_FOLDER = "Google/Estados/California"
# Nombre fijo del archivo compilado en esa carpeta:
COMPILADO_FILENAME = "compilado_California.json"
# Nombre de la subcarpeta donde se archivarán los crudos procesados:
ARCHIVADOS_SUBFOLDER = "archivos_compilados_California"

# --------------------------
# 4) Cliente de GCS
# --------------------------
def get_storage_client() -> storage.Client:
    """Inicializa y devuelve un cliente de Cloud Storage."""
    return storage.Client()

# --------------------------
# 5) Handler de Cloud Run
# --------------------------
def compilar_json(request: Request):
    """
    Recibe un evento CloudEvent de GCS vía Eventarc.
    Procesa sólo blobs en BASE_FOLDER que no sean compilados y no estén ya marcados.
    Genera o actualiza el NDJSON compilado, marca metadata y mueve el crudo a ARCHIVADOS.
    """
    try:
        event = request.get_json(force=True)
        bucket_name = event.get("bucket")
        blob_name   = event.get("name")
        if not bucket_name or not blob_name:
            logger.warning("⚠️ Evento inválido: faltan 'bucket' o 'name'.")
            return make_response("Bad Request: falta bucket/name", 400)

        # Sólo procesar crudos dentro de BASE_FOLDER
        if not blob_name.startswith(f"{BASE_FOLDER}/"):
            logger.info(f"Ignorado (fuera de {BASE_FOLDER}): {blob_name}")
            return make_response("Ignored", 200)

        file_name = blob_name.split("/")[-1]
        # Ignorar archivos compilado_*.json
        if file_name.startswith("compilado_"):
            logger.info(f"Ignorado (archivo compilado): {blob_name}")
            return make_response("Ignored", 200)

        client = get_storage_client()
        bucket = client.bucket(bucket_name)
        blob   = bucket.blob(blob_name)

        # Refrescar metadata y saltar si ya fue procesado
        blob.reload()
        md = blob.metadata or {}
        if md.get("processed") == "true":
            logger.info(f"Ignorado (ya procesado): {blob_name}")
            return make_response("Ignored", 200)

        # 1) Leer y parsear cada línea JSON
        text = blob.download_as_text()
        registros = []
        for i, line in enumerate(text.splitlines(), start=1):
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
                registros.append(json.dumps(obj, ensure_ascii=False))
            except Exception as e:
                logger.warning(f"⚠️ Línea {i} malformada en {file_name}: {e}")

        # 2) Preparar blob compilado
        carpeta_path   = "/".join(blob_name.split("/")[:-1])
        compilado_path = f"{carpeta_path}/{COMPILADO_FILENAME}"
        comp_blob      = bucket.blob(compilado_path)

        if comp_blob.exists():
            existing = comp_blob.download_as_text().splitlines()
            logger.info(f"ℹ️ Cargando compilado existente ({len(existing)} registros).")
        else:
            existing = []
            logger.info("ℹ️ No existe compilado previo; se creará uno nuevo.")

        # 3) Concatenar registros y subir compilado
        full = existing + registros
        comp_blob.upload_from_string(
            "\n".join(full),
            content_type="application/json"
        )
        logger.info(f"✅ Compilado actualizado: +{len(registros)} registros → {COMPILADO_FILENAME}")

        # 4) Marcar el blob crudo como procesado en metadata
        md["processed"] = "true"
        blob.metadata   = md
        blob.patch()
        logger.info(f"🔖 Metadata actualizada (processed=true): {blob_name}")

        # 5) Mover el crudo a la carpeta de archivados
        destino_folder = f"{carpeta_path}/{ARCHIVADOS_SUBFOLDER}"
        destino_name   = f"{destino_folder}/{file_name}"
        # Usamos copy_blob para mover dentro del mismo bucket
        bucket.copy_blob(blob, bucket, new_name=destino_name)
        blob.delete()
        logger.info(f"📂 Movido {blob_name} → {destino_name}")

        return make_response("OK", 200)

    except Exception as e:
        logger.error(f"❌ Error en compilar_json: {e}", exc_info=True)
        return make_response(f"Error interno: {e}", 500)
